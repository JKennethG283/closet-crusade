# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google accounts allowed into /admin (comma-separated). Must match private.admins in supabase/schema.sql.
ADMIN_EMAILS=ravenashley.blackbird@gmail.com,jonathan.kenneth.gunawan@gmail.com

# Optional. Site address for link previews; on Vercel it defaults to the production URL.
# Only set this for a custom domain, e.g. https://closetcrusade.com
SITE_URL=

# Any long random string; Vercel Cron sends it to /api/keep-alive.
CRON_SECRET=

# Only for running `npm run seed` on your computer. Never add this to Vercel or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
